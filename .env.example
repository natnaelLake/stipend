# Copy to .env, or let ./scripts/setup-testnet.sh generate a filled-in one for you:
#
#   cd agent && npm install && npm run gen-keys
#   ./scripts/setup-testnet.sh
#
# .env holds real testnet secret keys and is gitignored. Never commit it.

NEAR_NETWORK=testnet
# Optional overrides; sensible testnet defaults are built in.
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# NEAR_EXPLORER_TX_BASE=https://testnet.nearblocks.io/txns/

# --- accounts ---------------------------------------------------------------
STIPEND_ROOT=stipend-demo-xxxxxx.testnet
OWNER_ACCOUNT_ID=stipend-demo-xxxxxx.testnet
VAULT_CONTRACT_ID=vault.stipend-demo-xxxxxx.testnet
AGENT_ACCOUNT_ID=agent1.stipend-demo-xxxxxx.testnet
MERCHANT_ACCOUNT_ID=merchant.stipend-demo-xxxxxx.testnet
ATTACKER_ACCOUNT_ID=attacker.stipend-demo-xxxxxx.testnet
STRANGER_ACCOUNT_ID=supplier.stipend-demo-xxxxxx.testnet

# --- the agent's restricted key ---------------------------------------------
# A NEAR function-call access key permitted to call request_payment on the
# vault and nothing else. This is the ONLY credential the agent runner gets.
AGENT_FC_PRIVATE_KEY=ed25519:...
AGENT_FC_PUBLIC_KEY=ed25519:...

# --- full-access keys: setup scripts and the owner-approval demo only -------
OWNER_PRIVATE_KEY=ed25519:...
OWNER_PUBLIC_KEY=ed25519:...
VAULT_PRIVATE_KEY=ed25519:...
VAULT_PUBLIC_KEY=ed25519:...
AGENT_PRIVATE_KEY=ed25519:...
AGENT_PUBLIC_KEY=ed25519:...
MERCHANT_PRIVATE_KEY=ed25519:...
MERCHANT_PUBLIC_KEY=ed25519:...
ATTACKER_PRIVATE_KEY=ed25519:...
ATTACKER_PUBLIC_KEY=ed25519:...
STRANGER_PRIVATE_KEY=ed25519:...
STRANGER_PUBLIC_KEY=ed25519:...

# --- LLM scenarios (injection only; the deterministic ones need no key) -----
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
